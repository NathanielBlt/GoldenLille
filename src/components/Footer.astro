---
interface Props {
  howItWorksHref?: string;
  howItWorksLabel?: string;
}

const { howItWorksHref, howItWorksLabel } = Astro.props;
---

<footer class="footer">
  {
    howItWorksHref && (
      <a class="btn" href={howItWorksHref}>
        {howItWorksLabel}
      </a>
    )
  }
  <p class="signature">
    <svg class="signature__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        d="M15.4 6.2C14.1 5.1 12.5 4.5 10.8 4.5c-4.1 0-7.4 3.4-7.4 7.5s3.3 7.5 7.4 7.5c1.9 0 3.6-.7 4.9-2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
      <circle cx="17.5" cy="6" r="1.1" fill="currentColor" />
    </svg>
    Cenomancer
  </p>
</footer>
