---
interface Props {
  ctaLabel: string;
}

const { ctaLabel } = Astro.props;
---

<dialog id="place-teaser-dialog" class="dialog dialog--teaser">
  <button type="button" class="dialog__close" data-dialog-close aria-label="Close">&times;</button>
  <figure class="dialog__photo">
    <img data-teaser-photo src="" alt="" />
  </figure>
  <p class="dialog__kicker" data-teaser-kicker></p>
  <h2 data-teaser-title></h2>
  <p data-teaser-text></p>
  <a class="btn" data-teaser-cta href="#">{ctaLabel}</a>
</dialog>
