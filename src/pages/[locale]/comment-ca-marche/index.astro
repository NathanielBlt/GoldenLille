---
import HowItWorksPage from '../../../components/pages/HowItWorksPage.astro';
import type { Lang } from '../../../i18n/utils';

export function getStaticPaths() {
  const locales: Exclude<Lang, 'en'>[] = ['fr', 'nl'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Lang };
---

<HowItWorksPage lang={locale} />
